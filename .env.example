# Note Digger — Environment Configuration

# Redis (change in production)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Aria-AMT
ARIA_AMT_MODEL=medium-double
ARIA_AMT_DEVICE=cpu

# Cloud GPU (AutoDL / CVM) for Aria-AMT Pro
# Deploy cloud_gpu_setup.sh on an AutoDL instance first, then set this:
# CLOUD_GPU_URL=http://your-gpu-instance-ip:8000

# Limits
MAX_UPLOAD_SIZE_MB=500
MAX_AUDIO_DURATION_SEC=1800

# Optional: GitHub token for model download (avoid rate limits)
# HF_TOKEN=hf_xxxxxxxxxxxxx
